#include <stdio.h>

int main()
{
    int i, quantidade = 0;
    float nota;

    for (i = 1; i <= 5; i++)
    {
        printf("Digite a nota %d: ", i);
        scanf("%f", &nota);

        if (nota >= 6)
        {
            quantidade++;
        }
    }

    printf("Quantidade de notas maiores ou iguais a 6: %d\n", quantidade);

    return 0;
}
